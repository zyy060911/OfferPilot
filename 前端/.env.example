# 浏览器加载的数字人嵌入页。默认走前端同源代理，兼容 HTTPS 页面。
VITE_DIGITAL_HUMAN_EMBED_URL=/digital-human/offerpilot-embed.html

# 仅供 Vite 开发服务器使用，不会暴露到浏览器。
DIGITAL_HUMAN_PROXY_TARGET=http://127.0.0.1:8010

# 面试预加载最长等待时间（毫秒）：后端首题、数字人通信和首个媒体画面必须全部就绪。
VITE_INTERVIEW_PREFLIGHT_TIMEOUT_MS=60000

# 候选人停顿 3 秒时切分 ASR 片段；停顿累计 7 秒时进入回答结束确认。
VITE_SEGMENT_SILENCE_MS=3000
VITE_ANSWER_FINISH_MS=7000

# 受控语音打断默认关闭。仅在完成真实扬声器、AEC 和麦克风矩阵验收后启用。
VITE_BARGE_IN_ENABLED=false
